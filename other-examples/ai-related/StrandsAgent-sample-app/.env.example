# OpenAI Configuration
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# New Relic Configuration
# This is used by the OTel Collector to export telemetry to New Relic
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key-here
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental,gen_ai_span_attributes_only
