apiVersion: v1
kind: Secret
metadata:
  name: newrelic-secret
  namespace: otel-apps
stringData:
  # New Relic license key. Referenced by the application Pods (no Collector in
  # this architecture): the New Relic agent's own license key, and the
  # OTLP api-key header for the OTel SDK.
  # docs: https://docs.newrelic.com/docs/apis/intro-apis/new-relic-api-keys/#license-key
  NEW_RELIC_LICENSE_KEY: <INSERT_LICENSE_KEY>
  # US default. If your account is based in the EU, use https://otlp.eu01.nr-data.net
  NEW_RELIC_OTLP_ENDPOINT: https://otlp.nr-data.net
